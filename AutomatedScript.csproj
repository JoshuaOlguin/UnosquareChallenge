<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Target modern framework -->
    <TargetFramework>net8.0</TargetFramework>
    <!-- Always use latest C# features -->
    <LangVersion>latest</LangVersion>
    <!-- Enable nullable reference types -->
    <Nullable>enable</Nullable>
    <!-- Enable implicit global usings -->
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Assembly metadata (replaces AssemblyInfo.cs) -->
    <AssemblyTitle>AutomatedScript</AssemblyTitle>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Company>AutomatedScript</Company>
    <Product>AutomatedScript</Product>
    <Description>AutomatedScript test automation project</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Testing -->
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.2.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />

    <!-- Selenium -->
    <PackageReference Include="Selenium.WebDriver" Version="4.46.0" />
    <PackageReference Include="Selenium.Support" Version="4.46.0" />
    <PackageReference Include="Selenium.WebDriver.ChromeDriver" Version="151.0.7922.7700" />

    <!-- OpenTelemetry -->
    <PackageReference Include="OpenTelemetry" Version="1.15.3" />
    <PackageReference Include="OpenTelemetry.Api" Version="1.15.3" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.15.3" />
    <PackageReference Include="Azure.Monitor.OpenTelemetry.Exporter" Version="1.8.0" />

    <!-- Azure + Identity -->
    <PackageReference Include="Azure.Core" Version="1.54.0" />
    <PackageReference Include="Microsoft.Identity.Client" Version="4.83.1" />
    <PackageReference Include="Microsoft.IdentityModel.Abstractions" Version="8.14.0" />

    <!-- Logging + Config (aligned to 10.0.3 to avoid NU1605) -->
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.Primitives" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.Abstractions" Version="10.0.3" />

    <!-- JSON + Diagnostics -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Microsoft.ApplicationInsights" Version="3.1.2" />
    <PackageReference Include="System.Text.Json" Version="10.0.3" />
    <PackageReference Include="System.Diagnostics.DiagnosticSource" Version="10.0.10" />
  </ItemGroup>

</Project>